# ──────────────────────────────────────────────
# AutoDrive / ChainSUI 後端環境變數範例
#
# 這些變數對應 app/config.py。標「必填」者：非 DEBUG 模式下缺少會 fail-fast（拒絕啟動）。
# ⚠️ 切勿把真實機密提交到版本控制。生產環境請用 secret manager 注入，不要落地 .env。
# ──────────────────────────────────────────────

# 除錯模式：true 時機密缺失只警告；false（生產）時 fail-fast。
DEBUG=false

# ──────────────────────────────────────────────
# 資料庫（必填）— 完整 async DSN
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/autodrive

# Redis
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────
# 應用安全（必填）
# ──────────────────────────────────────────────
# JWT 簽章金鑰。請用強隨機值，例如：openssl rand -hex 32
SECRET_KEY=

# CORS 白名單（逗號分隔）。生產務必收斂為實際前端網域，勿用 "*"。
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# ──────────────────────────────────────────────
# Sui 區塊鏈
# ──────────────────────────────────────────────
SUI_NODE_URL=https://fullnode.testnet.sui.io:443
SUI_NETWORK=testnet

# 部署合約後填入（見 scripts/ops/deploy_and_init.sh 的輸出）
CONTRACT_PACKAGE_ID=
USER_REGISTRY_ID=
VEHICLE_REGISTRY_ID=
REFUND_POOL_ID=
PLATFORM_WALLET_ADDRESS=

# 平台/Agent 操作金鑰（Sui bech32，suiprivkey1...）。
# 非 MOCK_MODE 時必填。用於代發交易/付 gas；務必由 secret manager 注入。
OPERATOR_PRIVATE_KEY=

# 模擬模式：true 時跳過真實鏈上驗證（僅供本機開發；生產務必 false）。
MOCK_MODE=false

# ──────────────────────────────────────────────
# Walrus 去中心化存儲（軌跡 / 評價 / 退款佐證）
# ──────────────────────────────────────────────
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5

# ──────────────────────────────────────────────
# ZKP（Groth16 / snarkjs）
# ──────────────────────────────────────────────
ZKP_KEYS_DIR=/app/zkp_keys
ZKP_WASM_DIR=/app/zkp_wasm

# ──────────────────────────────────────────────
# Firebase Cloud Messaging（選填）
# ──────────────────────────────────────────────
FCM_SERVER_KEY=

# ──────────────────────────────────────────────
# 其他
# ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
LOG_LEVEL=INFO
LOG_TO_FILE=true
