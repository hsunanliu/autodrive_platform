# 根目錄 .env（docker-compose 使用）。後端完整變數見 backend/.env.example。
# ⚠️ 切勿把真實機密提交或落地；生產請用 secret manager 注入。

# PostgreSQL
POSTGRES_DB=autodrive
POSTGRES_USER=autodrive
POSTGRES_PASSWORD=CHANGE_ME

# Backend（SQLAlchemy async DSN，指向 docker-compose 的 db 服務）
DATABASE_URL=postgresql+asyncpg://autodrive:CHANGE_ME@db:5432/autodrive

# Redis
REDIS_URL=redis://redis:6379

# ── 後端必填（非 DEBUG 模式缺少會 fail-fast）──
DEBUG=false
SECRET_KEY=                 # openssl rand -hex 32
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Sui / Agent ──
SUI_NODE_URL=https://fullnode.testnet.sui.io:443
SUI_NETWORK=testnet
CONTRACT_PACKAGE_ID=        # 由 scripts/ops/deploy_and_init.sh 取得
OPERATOR_PRIVATE_KEY=       # Agent/平台金鑰，勿落地檔案
MOCK_MODE=false

# ── Walrus 去中心化存儲 ──
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# API Keys（選填）
GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=
